# Copy this file to .env.local and put your real key there.
# Get a Claude API key from https://platform.claude.com
ANTHROPIC_API_KEY=your-key-here

# Optional: choose a Claude model (default: claude-haiku-5-5 — fast and low cost for classrooms)
# CLAUDE_MODEL=claude-sonnet-5-5

# NASA data needs NO API key: NASA Trek tiles and the NASA Image and Video Library are public.
# Optional (testing only): point the server at another host instead of NASA.
# NASA_IMAGES_API_BASE=https://images-api.nasa.gov
# NASA_TREK_BASE=https://trek.nasa.gov/tiles
